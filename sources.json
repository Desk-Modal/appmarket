{
  "comment": "Declarative source list for the DeskModal App Market. The aggregator reads GitHub Releases from these repos and builds the catalog. CODEOWNERS-gated — third parties submit a publisher-signup issue, Desk-Modal adds their entry.",
  "publisher_keys": {
    "deskmodal-ci": {
      "algorithm": "ed25519",
      "source": "GitHub App (deskmodal-ci) signing key",
      "owner": "Desk-Modal"
    }
  },
  "categories": [
    { "id": "trading",    "name": "Trading",    "description": "Order entry, blotter, positions, portfolio" },
    { "id": "charting",   "name": "Charting",   "description": "Price charts, indicators, drawing tools" },
    { "id": "data",       "name": "Data",       "description": "Market data feeds and streaming" },
    { "id": "analytics",  "name": "Analytics",  "description": "Cross-instrument analysis and metrics" },
    { "id": "simulation", "name": "Simulation", "description": "Paper trading, backtesting, replay" },
    { "id": "scripting",  "name": "Scripting",  "description": "Indicator and strategy scripting" },
    { "id": "indicator-pack", "name": "Indicator Packs", "description": "Third-party indicator bundles for the chart engine — OptiScript / WASM cdylib, registered via the indicator registry on install" },
    { "id": "branding",   "name": "Branding",   "description": "Brand themes and white-label packs" },
    { "id": "platform",   "name": "Platform",   "description": "DeskModal agent and core components" }
  ],
  "bundled_packs": [
    {
      "id": "deskmodal-default",
      "type": "theme",
      "name": "DeskModal Default",
      "tagline": "The original DeskModal brand — dark navy + brand red-orange",
      "description": "The original DeskModal brand pack: dark navy + brand red-orange accent. Apple-school glass, OKLCH-aligned, 4px grid. Ships pre-installed with DeskModal.",
      "categories": ["branding"],
      "tags": ["theme", "brand", "default", "dark"],
      "featured": true,
      "publisher": { "id": "deskmodal", "name": "DeskModal Technologies", "verified": true },
      "version": "1.0.0",
      "license": "Proprietary"
    }
  ],
  "sources": [
    {
      "owner": "Desk-Modal",
      "repo": "deskmodal",
      "mode": "single_release",
      "content_type": "platform",
      "id": "deskmodal",
      "display_name": "DeskModal",
      "tagline": "FDC3 2.2 Desktop Agent for multi-asset trading",
      "categories": ["platform"],
      "tags": ["agent", "fdc3", "desktop"],
      "featured": true,
      "asset_name_template": "DeskModal-{version}-{platform}.{ext}"
    },
    {
      "owner": "Desk-Modal",
      "repo": "tradesurface",
      "mode": "multi_plugin_release",
      "content_type": "app",
      "plugins": [
        { "slug": "feeds",        "id": "deskmodal.feeds",        "display_name": "Price Feed Hub",      "tagline": "Real-time multi-exchange price feeds",          "categories": ["data"],        "featured": true  },
        { "slug": "chart",        "id": "deskmodal.chart",        "display_name": "Chart",               "tagline": "Advanced charting with 50+ indicators",         "categories": ["charting"],    "featured": true  },
        { "slug": "watchlist",    "id": "deskmodal.watchlist",    "display_name": "Watchlist",           "tagline": "Multi-exchange watchlist with streaming quotes", "categories": ["trading"],     "featured": true  },
        { "slug": "depth",        "id": "deskmodal.depth",        "display_name": "Depth",               "tagline": "Cross-exchange order book depth",                "categories": ["trading"],     "featured": false },
        { "slug": "analytics",    "id": "deskmodal.analytics",    "display_name": "Analytics",           "tagline": "Market analytics and cross-exchange metrics",    "categories": ["analytics"],   "featured": false },
        { "slug": "screener",     "id": "deskmodal.screener",     "display_name": "Screener",            "tagline": "Real-time market screener with custom filters",  "categories": ["trading"],     "featured": false },
        { "slug": "alerts",       "id": "deskmodal.alerts",       "display_name": "Alerts",              "tagline": "Price alerts and condition monitoring",          "categories": ["trading"],     "featured": false },
        { "slug": "order-ticket", "id": "deskmodal.order-ticket", "display_name": "Order Ticket",        "tagline": "Order entry widget",                             "categories": ["trading"],     "featured": true  },
        { "slug": "blotter",      "id": "deskmodal.blotter",      "display_name": "Order Blotter",       "tagline": "Working and filled orders log",                  "categories": ["trading"],     "featured": false },
        { "slug": "positions",    "id": "deskmodal.positions",    "display_name": "Positions",           "tagline": "Cross-exchange position viewer",                 "categories": ["trading"],     "featured": false },
        { "slug": "news",         "id": "deskmodal.news",         "display_name": "News Wire",           "tagline": "Real-time news with 4-state severity ribbon, multi-source aggregation, drag-to-chart annotations", "categories": ["data"],        "featured": true  },
        { "slug": "earnings",     "id": "deskmodal.earnings",     "display_name": "Earnings Calendar",   "tagline": "Week-grid earnings + crypto unlocks with implied-move, consensus blend, post-event reaction tracker", "categories": ["data", "trading"], "featured": true }
      ],
      "services": [
        { "id": "deskmodal.price-feed",     "display_name": "Price Feed Service",     "tagline": "Multi-exchange WebSocket streaming",     "categories": ["data"],       "featured": true  },
        { "id": "deskmodal.paper-trading",  "display_name": "Paper Trading Service",  "tagline": "Risk-free order simulation with realistic fills", "categories": ["trading", "simulation"], "featured": true  },
        { "id": "deskmodal.news-feed",      "display_name": "News Feed Service",      "tagline": "Multi-source news aggregation: Cryptopanic, NewsAPI, RSS, Coinbase, Binance", "categories": ["data"], "featured": false },
        { "id": "deskmodal.earnings-feed",  "display_name": "Earnings Feed Service",  "tagline": "Multi-source earnings + crypto-events: FMP, Polygon, CryptoRank, EarningsWhispers", "categories": ["data"], "featured": false }
      ],
      "asset_name_template": "tradesurface-{slug}-{version}-{platform}.dmpkg"
    },
    {
      "owner": "Desk-Modal",
      "repo": "optiscript",
      "mode": "single_release",
      "content_type": "plugin",
      "id": "optiscript",
      "display_name": "OptiScript",
      "tagline": "Write, run, and backtest trading indicators and strategies",
      "categories": ["scripting", "simulation"],
      "tags": ["scripting", "indicators", "backtesting", "pine"],
      "featured": true,
      "asset_name_template": "optiscript-{version}-{platform}.dmpkg"
    },
    {
      "comment": "F133-W13 first-party indicator packs. These cdylib services are built locally by scripts/build-dist.sh and walked from dist/plugins/<id>/; this source block carries ONLY their category + per-indicator metadata so scripts/lib/build_appmarket_catalog.py emits the `indicator-pack` category + indicators[] preview block. The platform/signature/checksums fields come from the local plugin walk, not a GitHub release. Schema: schema/indicator-pack.md. Validated by scripts/validate_catalog.py --category indicator-pack.",
      "owner": "Desk-Modal",
      "repo": "deskmodal",
      "mode": "local_indicator_packs",
      "content_type": "service",
      "services": [
        {
          "id": "deskmodal.footprint",
          "display_name": "Footprint / Cluster Delta",
          "tagline": "Per-bar bid/ask volume grid, POC, stacked-imbalance detection",
          "categories": ["indicator-pack", "charting"],
          "featured": true,
          "indicators": [
            {
              "id": "footprint.cluster-delta",
              "display_name": "Cluster Delta Footprint",
              "category": "volume",
              "description": "Per-bar bid/ask volume grid; each price cell coloured by cluster delta (ask_volume - bid_volume). Surfaces who moved price, not just that it moved.",
              "inputs": ["bid_volume", "ask_volume", "bar_period_minutes", "cell_granularity_ticks"],
              "outputs": ["delta", "cell_grid"]
            },
            {
              "id": "footprint.poc-imbalance",
              "display_name": "POC Bid/Ask Imbalance",
              "category": "volume",
              "description": "Point-of-control bid/ask imbalance: the intra-bar price level with the largest absolute cluster delta, marked as the bar's order-flow control price.",
              "inputs": ["bid_volume", "ask_volume", "imbalance_ratio"],
              "outputs": ["poc_price", "poc_delta"]
            },
            {
              "id": "footprint.stacked-imbalance",
              "display_name": "Stacked Imbalance",
              "category": "pattern",
              "description": "Bookmap-style unfinished-business detector: flags when the top or bottom price level of a bar prints with non-zero delta, marking a high-probability retest target.",
              "inputs": ["bid_volume", "ask_volume", "imbalance_ratio"],
              "outputs": ["has_unfinished_business", "retest_target"]
            }
          ]
        },
        {
          "id": "deskmodal.tpo",
          "display_name": "Market Profile (TPO)",
          "tagline": "Letter-grid, POC, Value Area, single prints, Initial Balance",
          "categories": ["indicator-pack", "charting"],
          "featured": true,
          "indicators": [
            {
              "id": "tpo.market-profile",
              "display_name": "TPO Market Profile",
              "category": "volume",
              "description": "Time-Price-Opportunity letter grid aggregating time-at-price across the session; renders the classic Market Profile distribution with POC and Value Area.",
              "inputs": ["price", "tpo_period_minutes", "value_area_pct"],
              "outputs": ["tpo_grid", "poc_price", "value_area_high", "value_area_low"]
            },
            {
              "id": "tpo.single-prints",
              "display_name": "Single Prints",
              "category": "pattern",
              "description": "Detects single-print TPO levels — prices touched in only one time bracket — flagging low-acceptance zones that often act as fast-fill gaps on retest.",
              "inputs": ["tpo_grid"],
              "outputs": ["single_print_levels"]
            },
            {
              "id": "tpo.initial-balance",
              "display_name": "Initial Balance",
              "category": "volatility",
              "description": "Marks the Initial Balance range (first N brackets of the session) and its extensions, the canonical Market Profile measure of early-session conviction.",
              "inputs": ["tpo_grid", "initial_balance_brackets"],
              "outputs": ["ib_high", "ib_low", "ib_extension"]
            }
          ]
        },
        {
          "id": "deskmodal.volume-profile",
          "display_name": "Volume Profile (VPVR)",
          "tagline": "Visible-Range Volume Profile — POC, Value Area, HVN/LVN overlay",
          "categories": ["indicator-pack", "charting"],
          "featured": true,
          "indicators": [
            {
              "id": "volume-profile.vpvr",
              "display_name": "Visible-Range VPVR",
              "category": "volume",
              "description": "Aggregates traded volume by price across the visible chart range into a horizontal histogram; surfaces point-of-control and Value Area for the displayed window.",
              "inputs": ["price", "volume", "row_count", "value_area_pct"],
              "outputs": ["volume_histogram", "poc_price", "value_area_high", "value_area_low"]
            },
            {
              "id": "volume-profile.hvn-lvn",
              "display_name": "HVN / LVN Nodes",
              "category": "volume",
              "description": "Classifies profile rows into High-Volume Nodes (acceptance / magnet) and Low-Volume Nodes (rejection / fast-move zones) for support-resistance mapping.",
              "inputs": ["volume_histogram", "hvn_threshold_pct", "lvn_threshold_pct"],
              "outputs": ["hvn_levels", "lvn_levels"]
            }
          ]
        }
      ]
    }
  ]
}
